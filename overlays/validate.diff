+def _chord_check(catalog: dict, score: dict) -> dict:
+    errors = []
+    by_id = {part["id"]: part for part in score["parts"]}
+    for kit in catalog["kits"]:
+        for variation, windows in kit["chords"].items():
+            part = by_id[f"{kit['id']}.keys.{variation}"]
+            covered = 0
+            for name, start_bar, bars in windows:
+                lo = start_bar * BAR
+                hi = (start_bar + bars) * BAR
+                group = [note for note in part["notes"] if lo <= note["performed_start"] < hi]
+                if not group:
+                    errors.append(f"{part['id']} empty {name}")
+                    continue
+                found = {note["pitch"] % 12 for note in group}
+                if found != CHORD_PCS[name]:
+                    errors.append(f"{part['id']} {name} {sorted(found)} != {sorted(CHORD_PCS[name])}")
+                covered += len(group)
+            if covered != len(part["notes"]):
+                errors.append(f"{part['id']} keys notes outside named chords")
+    return {"pass": not errors, "errors": errors, "windows": sum(len(kit["chords"]["a"]) + len(kit["chords"]["b"]) for kit in catalog["kits"])}
+
+
+def _section_check(score: dict) -> dict:
+    errors = []
+    rows = []
+    forms = []
+    for arrangement in score["arrangements"]:
+        sections = []
+        for index in range(4):
+            start = index * 8 * BAR_TICKS_4_4
+            end = start + 8 * BAR_TICKS_4_4
+            roles = []
+            total = 0
+            for track in arrangement["tracks"]:
+                if not track["source_part"]:
+                    continue
+                count = sum(1 for note in track["notes"] if start <= note["performed_start"] < end)
+                total += count
+                if count:
+                    roles.append(track["name"])
+            sections.append({"roles": roles, "notes": total})
+        role_sets = [tuple(section["roles"]) for section in sections]
+        forms.append(tuple(role_sets))
+        if len(set(role_sets)) < 4:
+            errors.append(f"{arrangement['kit_id']} repeated section {role_sets}")
+        counts = [section["notes"] for section in sections]
+        if max(counts) - min(counts) < 12:
+            errors.append(f"{arrangement['kit_id']} section counts {counts}")
+        rows.append({"kit_id": arrangement["kit_id"], "sections": sections})
+    if len(set(forms)) != 4:
+        errors.append("arrangement forms are not distinct")
+    return {"pass": not errors, "errors": errors, "kits": rows}
+
+
